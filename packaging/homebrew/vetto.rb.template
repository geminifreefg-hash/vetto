class Vetto < Formula
  desc "Daemon-less, root-less kernel sandbox and policy enforcement runtime for AI coding agents"
  homepage "https://github.com/shleder/vetto"
  version "__VERSION__"
  license "Apache-2.0"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/shleder/vetto/releases/download/v__VERSION__/vetto-macos-aarch64.tar.gz"
      sha256 "__MACOS_ARM_SHA256__"
    else
      url "https://github.com/shleder/vetto/releases/download/v__VERSION__/vetto-macos-x86_64.tar.gz"
      sha256 "__MACOS_INTEL_SHA256__"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/shleder/vetto/releases/download/v__VERSION__/vetto-linux-aarch64.tar.gz"
      sha256 "__LINUX_ARM_SHA256__"
    else
      url "https://github.com/shleder/vetto/releases/download/v__VERSION__/vetto-linux-x86_64.tar.gz"
      sha256 "__LINUX_INTEL_SHA256__"
    end
  end

  def install
    bin.install "vetto"
  end

  test do
    assert_match "vetto #{version}", shell_output("#{bin}/vetto --version")
  end
end
